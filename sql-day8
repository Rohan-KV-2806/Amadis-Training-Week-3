SELECT c.name, c.age, t.seat_number FROM customers c INNER JOIN tickets t ON c.id = t.id;
SELECT c.name, t.seat_number FROM customers c INNER JOIN tickets t ON c.id = t.id AND c.age > 18;
SELECT c.name, c.email FROM customers c INNER JOIN tickets t ON c.id = t.id AND ticket = 'VIP';

SELECT c.name, c.email, COALESCE(CAST(t.seat_number AS VARCHAR), 'no tickets') FROM customers c LEFT JOIN tickets t ON c.id = t.id;

SELECT c.name, COALESCE(t.ticket, 'no ticket') FROM customers c LEFT JOIN tickets t ON c.id = t.id WHERE t.ticket is null;

SELECT t.seat_number, t.ticket FROM tickets t LEFT JOIN customers c ON c.id = t.id WHERE c.id is NULL;

SELECT COALESCE(c.name, 'unreserved'), COALESCE(CAST(t.seat_number AS VARCHAR), 'no tickets') FROM customers c FULL JOIN tickets t ON c.id = t.id 

SELECT c.name, t.seat_number FROM customers c FULL JOIN tickets t on c.id = t.id WHERE c.id is null OR t.id is null;
SELECT c.name, t.seat_number FROM customers c FULL JOIN tickets t on c.id = t.id WHERE c.id is null AND t.id is null;

SELECT COALESCE(c.name, 'orphan ticket'), COALESCE(CAST(c.age AS VARCHAR), 'orphan ticket'), COALESCE(t.ticket, 'entry rejected'), COALESCE(CAST(t.seat_number AS VARCHAR), 'empty') FROM customers c FULL JOIN tickets t ON c.id = t.id OR c.age > 18; 
