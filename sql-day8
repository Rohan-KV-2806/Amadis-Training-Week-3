-- Create the sales_2023 table
CREATE TABLE sales_2023 (
    id INT,
    customer_name VARCHAR(50),
    amount INT
);

-- Insert 4 records into sales_2023
INSERT INTO sales_2023 (id, customer_name, amount) VALUES
(1, 'Alice', 500),
(2, 'Bob', 200),
(3, 'Charlie', 800),
(4, 'David', 150);

-- Create the sales_2024 table (notice it has the EXACT same columns and types)
CREATE TABLE sales_2024 (
    id INT,
    customer_name VARCHAR(50),
    amount INT
);

-- Insert 4 records into sales_2024
-- Notice Alice and Charlie appear here too! This will be important for UNION vs UNION ALL.
INSERT INTO sales_2024 (id, customer_name, amount) VALUES
(1, 'Alice', 600),
(2, 'Eve', 300),
(3, 'Charlie', 800),  -- Exact duplicate of the 2023 Charlie row
(4, 'Frank', 400);

select customer_name, amount from sales_2023 UNION select customer_name, amount from sales_2024;
select customer_name, amount from sales_2023 WHERE amount > 250 UNION select customer_name, amount from sales_2024 WHERE amount > 250;

select customer_name, amount from sales_2023 INTERSECT select customer_name, amount from sales_2024;
select customer_name, amount from sales_2023 except select customer_name, amount from sales_2024;
