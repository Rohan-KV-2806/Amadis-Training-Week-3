-- 7. FUNCTIONS (The Calculator)
-- ==========================================

-- Function to calculate bonus (10% unless they are an intern)
CREATE OR REPLACE FUNCTION calculate_bonus (x INT)
RETURNS REAL AS $$ 
DECLARE 
    emp_salary REAL;
    emp_role VARCHAR;
BEGIN
    SELECT salary, role INTO emp_salary, emp_role 
    FROM employees 
    WHERE id = x;

    IF emp_role = 'Intern' THEN
        RETURN 0;
    ELSE
        RETURN emp_salary * 0.10;
    END IF;
END;
 $$ LANGUAGE plpgsql;

SELECT calculate_bonus(2);

SELECT name, calculate_bonus(id) FROM employees;

CREATE OR REPLACE FUNCTION add_employee(
    emp_name VARCHAR, 
    emp_role VARCHAR, 
    emp_email VARCHAR, 
    emp_salary REAL
) 
RETURNS VOID AS $$ 
BEGIN
    INSERT INTO employees (name, role, email, salary) 
    VALUES (emp_name, emp_role, emp_email, emp_salary);
END;
 $$ LANGUAGE plpgsql;

SELECT add_employee('Ghost', 'CEO', 'ghost@gmail.com', 100000.00);

-- ==========================================
-- 8. PROCEDURES (The Robot Worker)
-- ==========================================

CREATE OR REPLACE PROCEDURE transfer_salary(
    sender_id INT, 
    receiver_id INT, 
    amount REAL
)
LANGUAGE plpgsql
AS $$ BEGIN

    UPDATE employees 
    SET salary = salary - amount 
    WHERE id = sender_id;

    UPDATE employees 
    SET salary = salary + amount 
    WHERE id = receiver_id;
    COMMIT;
END;
 $$;

-- Calling the procedure 
CALL transfer_salary(1, 2, 5000.00);