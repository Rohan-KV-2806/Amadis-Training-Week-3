-- Create a view of people making over 40k
CREATE VIEW high_earners AS
SELECT name, role, salary FROM employees WHERE salary > 40000;
CREATE VIEW interns AS
SELECT name, role, salary FROM employees WHERE role = 'Intern';

SELECT * FROM high_earners;
SELECT * FROM interns;

